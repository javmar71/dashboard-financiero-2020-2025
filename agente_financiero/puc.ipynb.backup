    "",
    "",
    "",
    "def obtener_taxonomia() -> List[Cuenta]:",
    "",
    "    return PU_CATALOGO",
    "",
    "",
    "",
    "",
    "",
    "def buscar_por_codigo(codigo: str) -> Optional[Cuenta]:",
    "",
    "    if codigo is None:",
    "",
    "        return None",
    "",
    "    for cuenta in PU_CATALOGO:",
    "",
    "        if cuenta.get(\"codigo\") == codigo:",
    "",
    "            return cuenta",
    "",
    "    return None",
    "",
    "",
    "",
    "",
    "",
    "def buscar_por_nombre(nombre: str) -> Optional[Cuenta]:",
    "",
    "    nombre_normalizado = nombre.strip().lower().replace(\"_\", \" \")",
    "",
    "    for cuenta in PU_CATALOGO:",
    "",
    "        nombre_canonico = cuenta.get(\"nombre_canonico\", \"\").strip().lower().replace(\"_\", \" \")",
    "",
    "        if nombre_canonico == nombre_normalizado:",
    "",
    "            return cuenta",
    "",
    "    for cuenta in PU_CATALOGO:",
    "",
    "        for sinonimo in cuenta.get(\"sinonimos\", []):",
    "",
    "            sinonimo_normalizado = sinonimo.strip().lower().replace(\"_\", \" \")",
    "",
    "            if sinonimo_normalizado == nombre_normalizado:",
    "",
    "                return cuenta",
    "",
    "    return None",
    "",
    "",
    "",
    "",
    "",
    "def obtener_sinonimos(nombre_canonico: str) -> List[str]:",
    "",
    "    cuenta = buscar_por_nombre(nombre_canonico)",
    "",
    "    if cuenta is None:",
    "",
    "        return []",
    "",
    "    return cuenta.get(\"sinonimos\", [])",
    "",
    "",
    "",
    "",
    "",
    "CLASES_VALIDAS = {\"ACTIVO\", \"PASIVO\", \"PATRIMONIO\", \"INGRESOS\", \"COSTOS\", \"GASTOS\"}",
    "GRUPOS_VALIDOS = {\"Corriente\", \"No Corriente\", \"Total\", \"Corriente o No Corriente\", \"No Operacional\", \"Operacional\"}",
    "NATUREZAS_VALIDAS = {\"DEBITO\", \"CREDITO\"}",
    "CLASIFICACIONES_VALIDAS = {\"CORRIENTE\", \"NO_CORRIENTE\", \"OPERACIONAL\", \"NO_OPERACIONAL\", None}",
    "",
    "CLASES_VALIDAS = {\"ACTIVO\", \"PASIVO\", \"PATRIMONIO\", \"INGRESOS\", \"COSTOS\", \"GASTOS\"}",
    "GRUPOS_VALIDOS = {\"Corriente\", \"No Corriente\", \"Total\", \"Corriente o No Corriente\", \"No Operacional\", \"Operacional\"}",
    "NATUREZAS_VALIDAS = {\"DEBITO\", \"CREDITO\"}",
    "CLASIFICACIONES_VALIDAS = {\"CORRIENTE\", \"NO_CORRIENTE\", \"OPERACIONAL\", \"NO_OPERACIONAL\", None}",
    "",
    "CLASES_VALIDAS = {\"ACTIVO\", \"PASIVO\", \"PATRIMONIO\", \"INGRESOS\", \"COSTOS\", \"GASTOS\"}",
    "GRUPOS_VALIDOS = {\"Corriente\", \"No Corriente\", \"Total\", \"Corriente o No Corriente\", \"No Operacional\", \"Operacional\"}",
    "NATUREZAS_VALIDAS = {\"DEBITO\", \"CREDITO\"}",
    "CLASIFICACIONES_VALIDAS = {\"CORRIENTE\", \"NO_CORRIENTE\", \"OPERACIONAL\", \"NO_OPERACIONAL\", None}",
    "",
    "def def validar_taxonomia() -> Dict[str, Any]:",
    "    errores: List[str] = []",
    "",
    "    if len(PU_CATALOGO) != 21:",
    "        errores.append(f\"Se esperaban 21 cuentas, pero hay {len(PU_CATALOGO)}\")",
    "",
    "    codigos = []",
    "    for i, cuenta in enumerate(PU_CATALOGO):",
    "        if not cuenta.get(\"nombre_canonico\"):",
    "            errores.append(f\"Cuenta {i}: falta nombre_canonico\")",
    "",
    "        codigo = cuenta.get(\"codigo\")",
    "        if codigo is not None:",
    "            if codigo in codigos:",
    "                errores.append(f\"C\u00f3digo duplicado: {codigo}\")",
    "            codigos.append(codigo)",
    "",
    "        clase = cuenta.get(\"clase\")",
    "        if clase is not None:",
    "            if clase not in CLASES_VALIDAS:",
    "                errores.append(f\"Cuenta {i}: clase inv\u00e1lida {clase}\")",
    "",
    "        natural = cuenta.get(\"naturaleza\")",
    "        if natural is not None:",
    "            if natural not in NATUREZAS_VALIDAS:",
    "                errores.append(f\"Cuenta {i}: naturaleza inv\u00e1lida {natural}\")",
    "",
    "        grupo = cuenta.get(\"grupo\")",
    "        if grupo is not None:",
    "            if grupo not in GRUPOS_VALIDOS:",
    "                errores.append(f\"Cuenta {i}: grupo inv\u00e1lido {grupo}\")",
    "",
    "        clasificacion = cuenta.get(\"clasificacion\")",
    "        if clasificacion is not None:",
    "            if clasificacion not in CLASIFICACIONES_VALIDAS:",
    "                errores.append(f\"Cuenta {i}: clasificaci\u00f3n inv\u00e1lida {clasificacion}\")",
    "",
    "        sinonimos = cuenta.get(\"sinonimos\", [])",
    "        if not isinstance(sinonimos, list):",
    "            errores.append(f\"Cuenta {i}: sinonimos no es lista\")",
    "        else:",
    "            for s in sinonimos:",
    "                if not isinstance(s, str):",
    "                    errores.append(f\"Cuenta {i}: sinonimo no es string: {s}\")",
    "",
    "    return {",
    "        \"valido\": len(errores) == 0,",
    "        \"errores\": errores,",
    "        \"total_cuentas\": len(PU_CATALOGO),",
    "    }",
    "",
    "if __name__ == \"__main__\":",
    "",
    "    taxonomia = obtener_taxonomia()",
    "",
    "    validacion = validar_taxonomia()",
    "",
    "",
    "",
